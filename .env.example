# =====================================================================
#  MCP SECURITY VISION · configuración de ejemplo
#  Copia este archivo a `.env`  (cp .env.example .env)  y ajusta los valores.
#  NUNCA subas tu `.env` real al repositorio: contiene contraseñas.
# =====================================================================

# ---------------------------------------------------------------------
# 1) CÁMARAS
# ---------------------------------------------------------------------
# Opción A · UNA sola cámara:
#   - Webcam / capturadora USB-analógica: índice del dispositivo (0, 1, 2...)
#   - Cámara IP: URL RTSP con usuario y contraseña
#   - DVR/XVR (analógicas coaxiales): RTSP del canal correspondiente
#   - "synthetic" para probar sin hardware (modo demo)
CAMERA_SOURCE=0
CAMERA_ID=cam1
CAMERA_NAME=Cámara principal

# Opción B · VARIAS cámaras (JSON). Si defines CAMERAS, se ignoran las 3 de arriba.
# Formato corto: {"id": "fuente"}
# CAMERAS={"entrada": "rtsp://admin:MiClave@192.168.1.50:554/Streaming/Channels/101", "patio": 0, "demo": "synthetic"}
#
# Formato largo (nombre visible + habilitar/deshabilitar):
# CAMERAS=[{"id":"entrada","name":"Puerta principal","source":"rtsp://admin:MiClave@192.168.1.50:554/Streaming/Channels/101"},{"id":"patio","name":"Patio trasero","source":0},{"id":"demo","name":"Cámara demo","source":"synthetic"}]

# Ejemplos de URL RTSP de marcas habituales:
#   Hikvision cámara : rtsp://usuario:clave@192.168.1.50:554/Streaming/Channels/101
#   Hikvision DVR    : rtsp://admin:12345@192.168.1.100:554/Streaming/Channels/101  (canal 1)
#   Dahua            : rtsp://admin:clave@192.168.1.51:554/cam/realmonitor?channel=1&subtype=0
#   TP-Link Tapo     : rtsp://usuario:clave@192.168.1.52:554/stream1
#   Reolink          : rtsp://usuario:clave@192.168.1.53:554/h264Preview_01_main
#   Substream (menos CPU, más fluido): .../Streaming/Channels/102, /stream2, subtype=1

# ---------------------------------------------------------------------
# 2) VISIÓN ARTIFICIAL
# ---------------------------------------------------------------------
# Procesar IA cada N fotogramas (sube el número si la CPU va justa)
PROCESS_EVERY_N_FRAMES=5
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.5
YOLO_IMGSZ=640
# "cpu", "0" (primera GPU CUDA), "mps" (Apple Silicon). Vacío = autodetección
YOLO_DEVICE=

# Reconocimiento facial
FACES_ENABLED=true
# hog = rápido en CPU (por defecto) | cnn = más preciso, necesita GPU para ir fluido
FACE_MODEL=hog
FACE_TOLERANCE=0.6
FACE_SCALE=0.25
# Un nombre debe aparecer en FACE_STABILIZER_MIN_VOTES de las últimas FACE_STABILIZER_WINDOW lecturas
FACE_STABILIZER_WINDOW=3
FACE_STABILIZER_MIN_VOTES=2
# Reconocer caras aunque YOLO no detecte "person" en ese frame (más CPU)
FACES_WITHOUT_PERSON=false

# ---------------------------------------------------------------------
# 3) EVENTOS Y EVIDENCIAS
# ---------------------------------------------------------------------
EVENT_COOLDOWN_SECONDS=20
INTRUSION_COOLDOWN_SECONDS=30
PRESENCE_TIMEOUT_SECONDS=2.5
SNAPSHOT_ON_ALERT=true

# ---------------------------------------------------------------------
# 4) RUTAS (relativas a la raíz del repositorio o absolutas)
# ---------------------------------------------------------------------
DB_PATH=data/security.db
KNOWN_FACES_DIR=known_faces
SNAPSHOTS_DIR=snapshots
# Zonas iniciales al arrancar (solo se importan si la zona no existe todavía)
ZONES_SEED_FILE=config/zones.example.json

# ---------------------------------------------------------------------
# 5) RECONEXIÓN DE CÁMARAS
# ---------------------------------------------------------------------
RECONNECT_DELAY_SECONDS=5
MAX_RECONNECT_DELAY_SECONDS=60
# Transporte RTSP: tcp (estable, recomendado) | udp | auto
# Si la cámara entra en bucle de "sin señal", empieza aquí.
RTSP_TRANSPORT=tcp

# ---------------------------------------------------------------------
# 6) SERVIDOR MCP
# ---------------------------------------------------------------------
# stdio (Claude Desktop/Cursor) | sse | streamable-http (Docker/remoto)
MCP_TRANSPORT=stdio
# Mantén 127.0.0.1 salvo que uses Docker/proxy. El transporte HTTP no tiene auth.
MCP_HOST=127.0.0.1

# Directorio de datos cuando se instala con pip (por defecto, datos del usuario).
# En el repo/Docker se usa la raíz del proyecto o las rutas absolutas de abajo.
# MCP_SECURITY_VISION_HOME=/var/lib/mcp-security-vision
MCP_PORT=8000
# Lista de hosts/orígenes permitidos cuando se publica detrás de un proxy
# (los valores locales siguen permitidos; añade aquí tu dominio real)
# MCP_ALLOWED_HOSTS=mcp.midominio.com,mcp.midominio.com:*
# MCP_ALLOWED_ORIGINS=https://mcp.midominio.com

LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# 7) NOTIFICACIONES OPCIONALES (webhook JSON: n8n, Home Assistant, Slack...)
# ---------------------------------------------------------------------
# ALERT_WEBHOOK_URL=https://hooks.midominio.com/alertas
# ALERT_WEBHOOK_MIN_SEVERITY=warning

# ---------------------------------------------------------------------
# 8) MODO DEMO / CI · no carga YOLO ni dlib (respuestas simuladas)
# ---------------------------------------------------------------------
VISION_FAKE_MODELS=false
